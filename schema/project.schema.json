{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hourglazs project",
  "type": "object",
  "required": [
    "name",
    "key"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "key": {
      "type": "string",
      "description": "Task ID prefix, e.g. HG for HG-12"
    },
    "color": {
      "enum": [
        "red",
        "amber",
        "green",
        "violet",
        "cyan",
        "rose",
        "clay",
        "sage"
      ],
      "default": "red"
    },
    "description": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/log"
      }
    },
    "public": {
      "type": "boolean",
      "default": true,
      "description": "Show on the public progress page"
    },
    "finished": {
      "$ref": "#/$defs/date",
      "description": "When the project was finished; it then appears under Past projects"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Repo or demo link shown under Past projects"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique within the project; used in URLs"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "backlog",
            "todo",
            "doing",
            "done"
          ],
          "default": "todo"
        },
        "priority": {
          "enum": [
            "high",
            "med",
            "medium",
            "low"
          ],
          "default": "med"
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "Duration in calendar days; use with start or due"
        },
        "hours": {
          "type": "number",
          "minimum": 0,
          "description": "Effort estimate"
        },
        "done_on": {
          "$ref": "#/$defs/date",
          "description": "Completion date; set automatically by hourglazs serve"
        },
        "milestone": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "description": "Blank lines separate paragraphs"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "log": {
      "type": "object",
      "required": [
        "at",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "description": "YYYY-MM-DD or YYYY-MM-DDTHH:MM"
        },
        "task": {
          "type": "string",
          "description": "Task ID this entry is about"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "note",
            "event"
          ],
          "default": "note"
        }
      }
    }
  }
}
